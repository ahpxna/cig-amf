-def _replicate_example_network(roadnet, flows, copies):
-    """Create independent copies of a bundled one-junction example at runtime.
-
-    The pinned CityFlow repository ships only a single controllable example,
-    while the external-training CLI has an explicit population-size contract.
-    This helper constructs a temporary multi-intersection scenario without
-    mutating the pinned checkout.  It is a training-foundation scenario only;
-    causal benchmark panels remain capability-gated.
-    """
-    copies = int(copies)
-    intersections, roads, result_flows = [], [], []
-    base_intersections = list(roadnet.get("intersections", []))
-    base_roads = list(roadnet.get("roads", []))
-    for copy_id in range(copies):
-        suffix = f"__cig{copy_id}"
-        intersection_ids = {
-            str(item["id"]): f"{item['id']}{suffix}"
-            for item in base_intersections
-        }
-        road_ids = {
-            str(item["id"]): f"{item['id']}{suffix}"
-            for item in base_roads
-        }
-        offset_x, offset_y = float(copy_id % 3) * 1000.0, float(copy_id // 3) * 1000.0
-        for source in base_intersections:
-            item = copy.deepcopy(source)
-            item["id"] = intersection_ids[str(source["id"])]
-            item["roads"] = [road_ids[str(road)] for road in source.get("roads", [])]
-            point = item.get("point")
-            if isinstance(point, dict):
-                point["x"] = float(point.get("x", 0.0)) + offset_x
-                point["y"] = float(point.get("y", 0.0)) + offset_y
-            for link in item.get("roadLinks", []):
-                link["startRoad"] = road_ids[str(link["startRoad"])]
-                link["endRoad"] = road_ids[str(link["endRoad"])]
-                for lane_link in link.get("laneLinks", []):
-                    for lane_point in lane_link.get("points", []):
-                        lane_point["x"] = float(lane_point.get("x", 0.0)) + offset_x
-                        lane_point["y"] = float(lane_point.get("y", 0.0)) + offset_y
-            intersections.append(item)
-        for source in base_roads:
-            item = copy.deepcopy(source)
-            item["id"] = road_ids[str(source["id"])]
-            item["startIntersection"] = intersection_ids[str(source["startIntersection"])]
-            item["endIntersection"] = intersection_ids[str(source["endIntersection"])]
-            for point in item.get("points", []):
-                point["x"] = float(point.get("x", 0.0)) + offset_x
-                point["y"] = float(point.get("y", 0.0)) + offset_y
-            roads.append(item)
-        for source in flows:
-            item = copy.deepcopy(source)
-            item["route"] = [road_ids[str(road)] for road in source.get("route", [])]
-            result_flows.append(item)
-    return {"intersections": intersections, "roads": roads}, result_flows
