"""Executable capability audit for pinned external CIG-AMF benchmarks.

The suite validates both declarative capabilities and the methods/runtime path
required by the selected panel.  It does not silently promote a smoke test into
paper evidence: training smoke is architecture validation only, and H2/latency
remain blocked unless the adapter declares those scientific contracts.
"""
from __future__ import annotations

import argparse
import copy
import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from envs.external.runtime import ensure_output_file_parent, maybe_reexec_in_external_runtime

ENVIRONMENTS = ("cityflow", "cyborg", "flatland", "rware")


def _static_panel_support(environment, panel):
    from envs.external.registry import SPECS
    spec = SPECS[environment]
    cap = spec.capabilities
    if not cap.supports(panel):
        return False, "capability flag is disabled"
    cls_methods = {
        "training": ("clone_state", "restore_state", "reset", "step", "valid_action_mask"),
        "h1": ("clone_state", "restore_state", "fixed_continuation_policy", "oracle_lag_response"),
        "h2": ("clone_state", "restore_state", "apply_structural_intervention", "apply_behavioural_intervention"),
        "latency": ("clone_state", "restore_state", "fixed_continuation_policy", "oracle_lag_response"),
    }
    # The runtime object is authoritative; static method checks are performed
    # after construction because some wrappers delegate methods through a base.
    return True, ""


def _runtime_smoke(env):
    import numpy as np
    observations = env.reset(seed=123)
    if len(observations) != int(env.n_agents):
        raise RuntimeError("reset did not return one observation per agent")
    masks = [np.asarray(env.valid_action_mask(i), dtype=bool) for i in range(env.n_agents)]
    if any(mask.shape != (env.get_action_dim(),) or not np.any(mask) for mask in masks):
        raise RuntimeError("invalid state-dependent action mask")
    before = env.clone_state()
    actions = [int(np.flatnonzero(mask)[0]) for mask in masks]
    next_obs, rewards, done, info = env.step(actions)
    if len(next_obs) != env.n_agents or len(rewards) != env.n_agents:
        raise RuntimeError("step did not return a population transition")
    env.restore_state(copy.deepcopy(before))
    restored = env._get_obs_all()
    if len(restored) != env.n_agents:
        raise RuntimeError("clone/restore did not restore a population state")
    return {
        "n_agents": int(env.n_agents),
        "action_dim": int(env.get_action_dim()),
        "obs_dim": int(env.get_obs_dim()),
        "one_step_done": bool(done),
        "reward_mean": float(np.mean(np.asarray(rewards, dtype=np.float64))),
    }


def _h1_smoke(
    env, *, max_states=8, max_interventions=64, horizon=2, response_tolerance=1e-9,
):
    """Probe whether the H1 action-response interface has active support.

    A single executable oracle call is not enough to call H1 runnable: the
    sampled state/action pair can legitimately have zero downstream effect.
    Scan a small deterministic state bank and several ego/source pairs, while
    keeping this command a smoke test rather than a confirmatory experiment.
    """
    import numpy as np

    if env.n_agents < 2:
        raise RuntimeError("H1 smoke requires at least two agents")
    max_states = max(1, int(max_states))
    max_interventions = max(1, int(max_interventions))
    horizon = max(1, int(horizon))
    response_tolerance = float(response_tolerance)
    if response_tolerance < 0.0:
        raise ValueError("response_tolerance must be non-negative")

    required = {"per_lag_response", "discounted_response", "response_mass"}
    masses = []
    discounted = []
    states_tested = 0
    valid_interventions = 0
    active_interventions = 0
    reset_index = 0

    env.reset(seed=321)
    while states_tested < max_states and valid_interventions < max_interventions:
        states_tested += 1
        for source in range(int(env.n_agents)):
            mask = np.asarray(env.valid_action_mask(source), dtype=bool)
            if mask.shape != (env.get_action_dim(),) or not np.any(mask):
                raise RuntimeError("H1 smoke received an invalid action mask")
            valid = np.flatnonzero(mask)
            baseline = int(env.fixed_continuation_policy(source))
            alternatives = [int(a) for a in valid if int(a) != baseline]
            if not alternatives:
                continue
            intervention_action = alternatives[-1]
            for ego in range(int(env.n_agents)):
                if ego == source:
                    continue
                response = env.oracle_lag_response(
                    ego_id=ego, agent_j=source,
                    intervention_action=intervention_action,
                    horizon=horizon, n_trials=1, forced_step=0,
                    continuation_policy=env.fixed_continuation_policy,
                    discount=0.95,
                )
                if not required.issubset(response):
                    raise RuntimeError("oracle_lag_response returned an incomplete record")
                per_lag = np.asarray(response["per_lag_response"], dtype=np.float64).reshape(-1)
                if per_lag.shape != (horizon,) or not np.all(np.isfinite(per_lag)):
                    raise RuntimeError("oracle_lag_response returned a non-finite or wrong-sized lag vector")
                mass = float(response["response_mass"])
                disc = float(response["discounted_response"])
                if not np.isfinite(mass) or not np.isfinite(disc):
                    raise RuntimeError("oracle_lag_response returned non-finite summary values")
                masses.append(mass)
                discounted.append(disc)
                valid_interventions += 1
                if mass > response_tolerance or abs(disc) > response_tolerance:
                    active_interventions += 1
                if valid_interventions >= max_interventions:
                    break
            if valid_interventions >= max_interventions:
                break

        if states_tested >= max_states or valid_interventions >= max_interventions:
            break

        # Advance deterministically to inspect support away from the reset state.
        actions = [int(env.fixed_continuation_policy(i)) for i in range(int(env.n_agents))]
        _, _, done, _ = env.step(actions)
        if done:
            reset_index += 1
            env.reset(seed=321 + reset_index)

    masses_arr = np.asarray(masses, dtype=np.float64)
    discounted_arr = np.asarray(discounted, dtype=np.float64)
    signal_ready = bool(active_interventions > 0)
    return {
        "interface_ready": True,
        "signal_ready": signal_ready,
        "states_tested": int(states_tested),
        "valid_interventions": int(valid_interventions),
        "active_interventions": int(active_interventions),
        "active_response_fraction": (
            float(active_interventions / valid_interventions)
            if valid_interventions else 0.0
        ),
        "median_response_mass": float(np.median(masses_arr)) if masses_arr.size else 0.0,
        "max_response_mass": float(np.max(masses_arr)) if masses_arr.size else 0.0,
        "max_abs_discounted_response": (
            float(np.max(np.abs(discounted_arr))) if discounted_arr.size else 0.0
        ),
        "response_tolerance": response_tolerance,
        "horizon": horizon,
        "support_scope": "diagnostic smoke only; not confirmatory H1 evidence",
    }


def main(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("--environment", choices=ENVIRONMENTS, required=True)
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--panels", nargs="+", default=["training", "h1", "h2", "latency"])
    parser.add_argument("--agent-count", type=int, default=6)
    parser.add_argument("--max-steps", type=int, default=30)
    parser.add_argument("--config-path")
    parser.add_argument("--manifest-only", action="store_true")
    args = parser.parse_args(argv)
    if not args.manifest_only:
        maybe_reexec_in_external_runtime(require_ready=True)

    # Registry/adapters are intentionally imported after the optional runtime
    # handoff so external execution does not depend on the caller interpreter.
    from envs.external.registry import SPECS, build_environment, repo_path
    from envs.external_contract import require_panel

    declared_decisions = {
        panel: _static_panel_support(args.environment, panel) for panel in args.panels
    }
    decisions = dict(declared_decisions)
    runtime = {}
    runtime_errors = {}
    construction_error = None
    env = None
    if not args.manifest_only and any(ok for ok, _ in declared_decisions.values()):
        try:
            env = build_environment(
                args.environment, seed=0, n_agents=args.agent_count,
                max_steps=args.max_steps, config_path=args.config_path,
            )
        except Exception as exc:
            construction_error = f"{type(exc).__name__}: {exc}"
            for panel, (ok, _) in list(decisions.items()):
                if ok:
                    decisions[panel] = (
                        False, "runtime adapter construction failed: " + construction_error
                    )

        if env is not None and declared_decisions.get("training", (False,))[0]:
            try:
                require_panel(env, "training")
                runtime["training"] = _runtime_smoke(env)
            except Exception as exc:
                error = f"{type(exc).__name__}: {exc}"
                runtime_errors["training"] = error
                decisions["training"] = (
                    False, "training runtime check failed: " + error
                )

        if env is not None and declared_decisions.get("h1", (False,))[0]:
            try:
                require_panel(env, "h1")
                runtime["h1"] = _h1_smoke(env)
                if not runtime["h1"]["signal_ready"]:
                    if runtime["h1"]["valid_interventions"] == 0:
                        reason = (
                            "H1 interface is executable but the diagnostic state bank "
                            "contained no valid non-baseline interventions"
                        )
                    else:
                        reason = (
                            "H1 interface is executable but the diagnostic state/action "
                            "bank produced no measurable ego response above tolerance"
                        )
                    decisions["h1"] = (False, reason)
            except Exception as exc:
                error = f"{type(exc).__name__}: {exc}"
                runtime_errors["h1"] = error
                decisions["h1"] = (False, "H1 runtime check failed: " + error)

    cap = SPECS[args.environment].capabilities
    declared_panels = [
        panel for panel, (ok, _) in declared_decisions.items() if ok
    ]
    repository_exists = repo_path(args.environment).exists()
    if args.manifest_only:
        # Manifest mode reports declarative support only.  It must not call a
        # panel runtime-runnable when the pinned repository has not been
        # constructed and smoke-tested in this process.
        runnable_panels = []
        operational_status = "not_executed"
    else:
        # H1 is runnable only when both its executable interface and an active
        # sampled response are present.  Zero-response support remains visible
        # as a diagnostic, but cannot be promoted into paper evidence.
        runnable_panels = [
            panel for panel, (ok, _) in decisions.items()
            if ok and panel in runtime
        ]
        if construction_error:
            operational_status = "failed"
        elif runtime_errors:
            operational_status = "partial" if runtime else "failed"
        else:
            operational_status = "verified"
    diagnostic_panels = []
    if (
        "h1" in runtime
        and runtime["h1"].get("interface_ready")
        and not runtime["h1"].get("signal_ready")
    ):
        diagnostic_panels.append("h1")
    payload = {
        "environment": args.environment,
        "repository": str(repo_path(args.environment)),
        "repository_exists": repository_exists,
        "capabilities": vars(cap),
        "requested_panels": args.panels,
        "declared_supported_panels": declared_panels,
        "runnable_panels": runnable_panels,
        "diagnostic_panels": diagnostic_panels,
        "blocked_panels": [panel for panel, (ok, _) in decisions.items() if not ok],
        "blocked_reasons": {panel: reason for panel, (ok, reason) in decisions.items() if not ok},
        "runtime_smoke": runtime,
        "runtime_errors": runtime_errors,
        "construction_error": construction_error,
        "operational_status": operational_status,
        "manifest_only": bool(args.manifest_only),
        "rule": "blocked panels must not generate paper evidence",
        "training_scope": "architecture generalization; not causal identification",
        "h1_scope": (
            "diagnostic active-support smoke only; confirmatory H1 still requires "
            "the frozen oracle protocol"
        ),
    }
    migrated = ensure_output_file_parent(args.out)
    if migrated is not None:
        print(f"[EXTERNAL-OUT] preserved legacy output file as {migrated}", file=sys.stderr)
    args.out.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps(payload, sort_keys=True))
    # A blocked scientific panel is not an operational failure. Runtime adapter
    # failures are operational and return nonzero so experiment automation can
    # stop before treating the environment as ready.
    raise SystemExit(2 if (construction_error or runtime_errors) else 0)


if __name__ == "__main__":
    main()
